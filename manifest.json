{
  "name": "Flix Vision",
  "short_name": "Flix",
  "description": "A movie streaming app to watch your favorite movies and shows.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["tabbed", "window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#000000",
  "theme_color": "#000000",
  "orientation": "any",
  "id": "/?source=pwa",
  "lang": "en",
  "dir": "ltr",
  "categories": ["entertainment", "movies"],
  "iarc_rating_id": "",
  "prefer_related_applications": false,
  "related_applications": [],
  "scope_extensions": [],
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "shortcuts": [
    {
      "name": "Home",
      "short_name": "Home",
      "url": "./",
      "icons": [{ "src": "launchericon-192x192.png", "sizes": "192x192" }]
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "icons": [
    {
      "src": "launchericon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "launchericon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
